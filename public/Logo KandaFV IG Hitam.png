<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <!-- Black Circle Background -->
  <circle cx="250" cy="250" r="240" fill="#000000" stroke="#333333" stroke-width="6" />
  
  <g fill="#FFFFFF" transform="translate(40, 160)">
    <!-- Stylized K Logo Mark -->
    <path d="M 20,10 L 125,130 L 85,130 L 0,28 L 0,10 Z" />
    <path d="M 55,65 L 125,10 L 92,10 L 28,65 Z" />
    <circle cx="16" cy="118" r="12" />

    <!-- KANDAFV Typography -->
    <text x="145" y="102" font-family="'Plus Jakarta Sans', 'Inter', 'Montserrat', 'Arial Black', sans-serif" font-weight="900" font-size="68" letter-spacing="2">KANDA</text>
    <text x="395" y="102" font-family="'Plus Jakarta Sans', 'Inter', 'Montserrat', 'Helvetica', sans-serif" font-weight="200" font-size="68" letter-spacing="1">FV</text>
    <g transform="translate(485, 70)">
      <circle cx="0" cy="0" r="10" fill="none" stroke="#FFFFFF" stroke-width="2" />
      <text x="0" y="4" font-family="sans-serif" font-weight="800" font-size="11" text-anchor="middle">R</text>
    </g>
  </g>
</svg>
